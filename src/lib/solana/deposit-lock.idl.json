  "types": [
    {
      "name": "AgreementStatus",
      "docs": [
        "Lifecycle of a deposit agreement.",
        "",
        "Variant order is part of the serialized account layout. Preserve the first",
        "three discriminants (`Initialized = 0`, `Funded = 1`, `Closed = 2`) so",
        "existing Phase 5 accounts remain readable; append Phase 6 states only."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Initialized"
          },
          {
            "name": "Funded"
          },
          {
            "name": "Closed"
          },
          {
            "name": "SettlementProposed"
          },
          {
            "name": "Disputed"
          }
        ]
      }
    },
    {
      "name": "DepositAgreement",
      "docs": [
        "The on-chain deposit agreement for one accepted tenancy.",
        "",
        "Derived from `[b\"deposit\", tenancy_id_bytes]`; the account is the only",
        "authority able to move the vault's tokens (via program invocation), which",
        "is what makes the deposit non-custodial for both parties."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "version",
            "docs": [
              "Layout version (`AGREEMENT_VERSION`)."
            ],
            "type": "u8"
          },
          {
            "name": "bump",
            "docs": [
              "Canonical bump of this PDA."
            ],
            "type": "u8"
          },
          {
            "name": "status",
            "docs": [
              "Current lifecycle state."
            ],
            "type": {
              "defined": {
                "name": "AgreementStatus"
              }
            }
          },
          {
            "name": "tenancy_id",
            "docs": [
              "Raw 16 bytes of the Supabase tenancy UUID (RFC 4122 byte order)."
            ],
            "type": {
              "array": [
                "u8",
                16
              ]
            }
          },
          {
            "name": "landlord",
            "docs": [
              "Wallet that initialized the agreement (the landlord)."
            ],
            "type": "pubkey"
          },
          {
            "name": "tenant",
            "docs": [
              "Wallet allowed to fund the agreement — the stored tenant."
            ],
            "type": "pubkey"
          },
          {
            "name": "mint",
            "docs": [
              "The accepted mint for this deployment, copied at initialization."
            ],
            "type": "pubkey"
          },
          {
            "name": "vault",
            "docs": [
              "The vault token account (ATA of this agreement for `mint`)."
            ],
            "type": "pubkey"
          },
          {
            "name": "required_amount",
            "docs": [
              "Required deposit, in mint base units. Integer only — never floats."
            ],
            "type": "u64"
          },
          {
            "name": "deposited_amount",
            "docs": [
              "Amount actually transferred in (equals `required_amount` once funded)."
            ],
            "type": "u64"
          },
          {
            "name": "created_at",
            "docs": [
              "Unix timestamp of initialization."
            ],
            "type": "i64"
          },
          {
            "name": "funded_at",
            "docs": [
              "Unix timestamp of funding (0 until funded)."
            ],
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "DepositLockConfig",
      "docs": [
        "Deployment-specific configuration.",
        "",
        "The accepted mint lives here rather than inside program logic so a",
        "deployment can point at an official stablecoin or a clearly-labelled test",
        "mint without code changes. Initialized once per deployment."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "version",
            "docs": [
              "Layout version (`CONFIG_VERSION`)."
            ],
            "type": "u8"
          },
          {
            "name": "bump",
            "docs": [
              "Canonical bump of this PDA."
            ],
            "type": "u8"
          },
          {
            "name": "admin",
            "docs": [
              "Wallet that initialized the configuration (the deployer)."
            ],
            "type": "pubkey"
          },
          {
            "name": "allowed_mint",
            "docs": [
              "The only mint this deployment accepts for deposits."
            ],
            "type": "pubkey"
          },
          {
            "name": "allowed_decimals",
            "docs": [
              "Decimals of `allowed_mint` at configuration time."
            ],
            "type": "u8"
          },
          {
            "name": "created_at",
            "docs": [
              "Unix timestamp of configuration."
            ],
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "SettlementProposal",
      "docs": [
        "On-chain commitment to one landlord-proposed split.",
        "",
        "It is a separate PDA so Phase 5 agreement account bytes and sizes do not",
        "change. `proposal_version` increments each time a withdrawn proposal is",
        "replaced, preventing approval against stale terms. Reasons and evidence",
        "stay in Supabase; `terms_hash` binds the off-chain metadata snapshot."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "version",
            "type": "u8"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "agreement",
            "type": "pubkey"
          },
          {
            "name": "tenancy_id",
            "type": {
              "array": [
                "u8",
                16
              ]
            }
          },
          {
            "name": "landlord",
            "type": "pubkey"
          },
          {
            "name": "tenant",
            "type": "pubkey"
          },
          {
            "name": "proposer",
            "type": "pubkey"
          },
          {
            "name": "proposal_type",
            "type": {
              "defined": {
                "name": "SettlementType"
              }
            }
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "SettlementProposalStatus"
              }
            }
          },
          {
            "name": "landlord_amount",
            "type": "u64"
          },
          {
            "name": "tenant_amount",
            "type": "u64"
          },
          {
            "name": "proposal_version",
            "type": "u64"
          },
          {
            "name": "terms_hash",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "proposed_at",
            "type": "i64"
          },
          {
            "name": "responded_at",
            "type": "i64"
          },
          {
            "name": "settled_tenant_amount",
            "docs": [
              "Final on-chain payouts after accounting for any tokens donated to the",
              "vault outside the original exact funding transaction."
            ],
            "type": "u64"
          },
          {
            "name": "settled_landlord_amount",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "SettlementProposalStatus",
      "docs": [
        "Lifecycle of the one reusable proposal PDA attached to an agreement."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Draft"
          },
          {
            "name": "Active"
          },
          {
            "name": "Withdrawn"
          },
          {
            "name": "Challenged"
          },
          {
            "name": "Executed"
          }
        ]
      }
    },
    {
      "name": "SettlementType",
      "docs": [
        "The two mutually agreed outcomes supported in Phase 6."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "FullReturn"
          },
          {
            "name": "PartialDeduction"
          }
        ]
      }
    }
  ]
}