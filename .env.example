# Solana cluster DepositLock talks to. Defaults to devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Optional RPC override. Defaults to the public endpoint for the cluster above.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Supabase -----------------------------------------------------------------
# Phase 3A is local-only: take these from `npx supabase status` while the local
# stack is running. The anon key is public and constrained by row level
# security, so publishing it is safe - but never put a service role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
