# Solana cluster DepositLock talks to. Defaults to devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Optional RPC override. Defaults to the public endpoint for the cluster above.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Supabase -----------------------------------------------------------------
# Use the local values from `npx supabase status` for development, or the
# matching hosted project URL/key for deployment. The public key is RLS-bound.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may use this in place of PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ or expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin for SIWS allowed origins and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
